CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_AMBARELLA_UDC=y
CONFIG_DM_USB_GADGET=y
CONFIG_DM_USB=y

CONFIG_USB_GADGET_MANUFACTURER="AMBA"
CONFIG_USB_GADGET_VENDOR_NUM=0x18d1
CONFIG_USB_GADGET_PRODUCT_NUM=0x4ee0

#
# Fastboot
#
CONFIG_FASTBOOT_FLASH=y

# Fastboot flash
CONFIG_FASTBOOT_FLASH_NAND=y

