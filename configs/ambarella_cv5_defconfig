CONFIG_PARTITION_TYPE_GUID=y
CONFIG_SUPPORT_OF_CONTROL=y
CONFIG_DTC=y
CONFIG_OF_CONTROL=y
CONFIG_MULTI_DTB_FIT=y
#
# Memory allocator in board_f.
#  - malloc_simple.c
#
CONFIG_SYS_MALLOC_F_LEN=0x100000

#
# Serial
#
CONFIG_AMBARELLA_SERIAL=y
CONFIG_DM_SERIAL=y

CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_BASE=0x20e4000000
CONFIG_DEBUG_UART_CLOCK=24000000

#
# Pinctrl
#
CONFIG_PINCTRL=y
CONFIG_PINCTRL_FULL=y
CONFIG_PINCTRL_AMBARELLA=y

#
#GPIO
#
CONFIG_DM_GPIO=y
CONFIG_AMBARELLA_GPIO=y
CONFIG_CMD_GPIO=y

#
# I2C
#
CONFIG_SYS_I2C_AMBARELLA=y
CONFIG_DM_I2C=y
CONFIG_CMD_I2C=y

#
# Watchdog
#
CONFIG_WATCHDOG=y
CONFIG_WDT=y
CONFIG_WDT_AMBARELLA=y

#
# ETHERNET
#
#CONFIG_PHY_MICREL=y
#CONFIG_PHY_MICREL_KSZ90X1=y
CONFIG_PHY_REALTEK=y
CONFIG_DM_ETH=y
CONFIG_RGMII=y
CONFIG_ETH_AMBARELLA=y
CONFIG_CMD_MII=y
CONFIG_CMD_PING=y
CONFIG_NET_RANDOM_ETHADDR=y
CONFIG_CMD_NET=y
CONFIG_CMD_SYSBOOT=y

#
# NAND media
#
CONFIG_MTD=y
CONFIG_NAND_AMBARELLA=y
CONFIG_MTD_RAW_NAND=y
CONFIG_CMD_MTDPARTS=y
CONFIG_CMD_MTD=y

#
# MMC media
#
CONFIG_DM_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_AMBARELLA=y
CONFIG_CMD_MMC=y




#
# Regmap
#
CONFIG_REGMAP=y
CONFIG_SYSCON=y

