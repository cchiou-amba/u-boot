/dts-v1/;

/ {
	compatible = "ambarella,cv25_hazelnut", "ambarella,cv25";
	interrupt-parent = <0x1>;
	#address-cells = <0x1>;
	#size-cells = <0x1>;
	model = "Ambarella CV25 Hazelnut Board";

	aliases {
		serial0 = "/n_apb@e4000000/uart@e4000000";
		serial1 = "/n_ahb@e0000000/uart@e0017000";
		serial2 = "/n_ahb@e0000000/uart@e0018000";
		serial3 = "/n_ahb@e0000000/uart@e0019000";
		serial4 = "/n_ahb@e0000000/uart@e001a000";
		nand = "/n_ahb@e0000000/nand@e0002000";
		sd0 = "/n_ahb@e0000000/sdmmc0@e0004000";
		sd1 = "/n_ahb@e0000000/sdmmc1@e0005000";
		sd2 = "/n_ahb@e0000000/sdmmc2@e0016000";
		spinor = "/n_ahb@e0000000/spinor@e0001000";
		i2c0 = "/n_apb@e4000000/i2c@e4008000";
		i2c1 = "/n_apb@e4000000/i2c@e4009000";
		i2c2 = "/n_apb@e4000000/i2c@e400a000";
		i2c3 = "/n_apb@e4000000/i2c@e400b000";
		spi0 = "/n_ahb@e0000000/spi@e0011000";
		spi1 = "/n_ahb@e0000000/spi@e0012000";
		spi2 = "/n_ahb@e0000000/spi@e0013000";
		spi3 = "/n_ahb@e0000000/spi@e0014000";
		ethernet0 = "/n_ahb@e0000000/ethernet@e000e000";
	};

	chosen {
		linux,stdout-path = "/n_apb@e4000000/uart@e4000000";
		stdout-path = "serial0";
		bootargs = "console=ttyS0 ubi.mtd=lnx root=ubi0:rootfs rw rootfstype=ubifs init=/linuxrc";
		ambarella,pm-gpio-notify-mcu = <0x6a>;
	};

	memory {
		device_type = "memory";
		reg = <0x200000 0x7e00000>;
	};

	reserved-memory {
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		ranges;

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x3000000>;
			linux,cma-default;
		};

		iav_reserved: iav@0x40000000 {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x40000000 0x20000000>;
			linux,phandle = <0x3f>;
			phandle = <0x3f>;
		};

		cavalry_reserved: cavalry@0x60000000 {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x60000000 0x20000000>;
			linux,phandle = <0x4b>;
			phandle = <0x4b>;
		};
	};

	vp_module: vp_module {
		compatible = "ambarella,vp-module";
		interrupts = <0x0 0x6a 0x4>;
	};

	firmware {

		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};
	};

	pmu {
		compatible = "arm,cortex-a53-pmu";
		interrupts = <0x0 0x4 0x4 0x0 0x5 0x4 0x0 0x6 0x4 0x0 0x7 0x4>;
	};

	dram@0xdffe0000 {
		compatible = "ambarella,dram";
		reg = <0xdffe0000 0x8000>;
	};

	cpus {
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		cpu@0 {
			compatible = "arm,cortex-a53", "arm,armv8";
			device_type = "cpu";
			reg = <0x0>;
			enable-method = "spin-table";
		};

		cpu@1 {
			compatible = "arm,cortex-a53", "arm,armv8";
			device_type = "cpu";
			reg = <0x1>;
			enable-method = "spin-table";
		};

		cpu@2 {
			compatible = "arm,cortex-a53", "arm,armv8";
			device_type = "cpu";
			reg = <0x2>;
			enable-method = "spin-table";
		};

		cpu@3 {
			compatible = "arm,cortex-a53", "arm,armv8";
			device_type = "cpu";
			reg = <0x3>;
			enable-method = "spin-table";
		};
	};

	cpufreq {
		compatible = "ambarella,cpufreq";
		cpufreq-effective-clock = <0x0>;
		clocks = <0x2 0x3>;
		clock-names = "cortex_clk", "core_clk";
		clocks-frequency-cortex-core = <0x107ac0 0xa4100 0xc7380 0x7b0c0 0x927c0 0x52080>;
	};

	gic: interrupt-controller@f3000000 {
		compatible = "arm,gic-400";
		#interrupt-cells = <0x3>;
		#address-cells = <0x0>;
		interrupt-controller;
		reg = <0xf3001000 0x1000 0xf3002000 0x2000 0xf3004000 0x2000 0xf3006000 0x2000>;
		interrupts = <0x1 0x9 0xf04>;
		linux,phandle = <0x1>;
		phandle = <0x1>;
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x1 0xd 0xf08 0x1 0xe 0xf08 0x1 0xb 0xf08 0x1 0xa 0xf08>;
	};

	secure-monitor {
		compatible = "ambarella,secure-monitor";
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		device;
	};

	n_apb@e4000000 {
		compatible = "simple-bus";
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		reg = <0xe4000000 0x1000000>;
		ranges;

		uart0: uart@e4000000 {
			compatible = "ambarella,uart";
			reg = <0xe4000000 0x1000>;
			interrupts = <0x0 0x15 0x4>;
			pinctrl-names = "default";
			pinctrl-0 = <0x4>;
			clocks = <0x5>;
			status = "ok";
		};

		ir@e4001000 {
			compatible = "ambarella,ir";
			reg = <0xe4001000 0x1000>;
			interrupts = <0x0 0x14 0x4>;
			pinctrl-names = "default";
			pinctrl-0 = <0x6>;
			clocks = <0x7>;
			status = "disabled";
		};

		adc@e4003000 {
			compatible = "ambarella,adc";
			#io-channel-cells = <0x1>;
			reg = <0xe4003000 0x1000>;
			interrupts = <0x0 0xd 0x4>;
			clock-frequency = <0x2dc6c0>;
			clocks = <0x8>;
			amb,rct-regmap = <0x9>;
			amb,scaler-1v8 = <0x1>;
			status = "disabled";
		};

		i2c0: i2c@e4008000 {
			compatible = "ambarella,i2c";
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			reg = <0xe4008000 0x1000>;
			interrupts = <0x0 0xf 0x4>;
			pinctrl-names = "default";
			pinctrl-0 = <0xa>;
			clocks = <0xb>;
			clock-frequency = <0x186a0>;
			amb,i2c-class = <0x81>;
			status = "ok";

			ak4951: codec@12 {
				compatible = "ambarella,ak4951";
				#sound-dai-cells = <0x0>;
				reg = <0x12>;
				gpios = <0xc 0xd 0x0>;
				pwr-gpios = <0xc 0xe 0x1>;
				linux,phandle = <0x4d>;
				phandle = <0x4d>;
			};

			ambvin0@01 {
				compatible = "ambarella,ambvin";
				reg = <0x1>;
			};
		};

		i2c1: i2c@e4009000 {
			compatible = "ambarella,i2c";
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			reg = <0xe4009000 0x1000>;
			interrupts = <0x0 0x10 0x4>;
			pinctrl-names = "default";
			pinctrl-0 = <0xd>;
			clocks = <0xb>;
			clock-frequency = <0x186a0>;
			amb,i2c-class = <0x8>;
			status = "ok";
		};

		i2c2: i2c@e400a000 {
			compatible = "ambarella,i2c";
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			reg = <0xe400a000 0x1000>;
			interrupts = <0x0 0x11 0x4>;
			clocks = <0xb>;
			pinctrl-names = "default";
			pinctrl-0 = <0xe>;
			clock-frequency = <0x186a0>;
			amb,i2c-class = <0x81>;
			status = "ok";

			it66121@4c {
				compatible = "it66121";
				reg = <0x4c>;
				rst_gpios = <0xc 0x3 0x0>;
			};
		};

		i2c3: i2c@e400b000 {
			compatible = "ambarella,i2c";
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			reg = <0xe400b000 0x1000>;
			interrupts = <0x0 0x12 0x4>;
			clocks = <0xb>;
			pinctrl-names = "default";
			pinctrl-0 = <0xf>;
			clock-frequency = <0x186a0>;
			amb,i2c-class = <0x81>;
			status = "ok";

			pca9539: pca9539@74 {
				compatible = "nxp,pca9539";
				reg = <0x74>;
				gpio-controller;
				interrupt-parent = <0x10>;
				interrupt-controller;
				#gpio-cells = <0x2>;
				interrupts = <0x9 0x0>;
				linux,phandle = <0xc>;
				phandle = <0xc>;
			};

			isl12022: rtc@6f {
				compatible = "isil,isl12022";
				reg = <0x6f>;
			};

			ambvin1@01 {
				compatible = "ambarella,ambvin";
				reg = <0x1>;
			};
		};

		pwm0: pwm@e4004000 {
			compatible = "ambarella,pwm";
			reg = <0xe4004000 0x1000>;
			clock-frequency = <0x1e8480>;
			clocks = <0x11>;
			#pwm-cells = <0x3>;
			linux,phandle = <0x40>;
			phandle = <0x40>;
		};

		pwm1: pwm@e400c000 {
			compatible = "ambarella,pwm";
			reg = <0xe400c000 0x1000>;
			clock-frequency = <0x1e8480>;
			clocks = <0x11>;
			#pwm-cells = <0x3>;
		};

		pwm2: pwm@e400d000 {
			compatible = "ambarella,pwm";
			reg = <0xe400d000 0x1000>;
			clock-frequency = <0x989680>;
			clocks = <0x11>;
			#pwm-cells = <0x3>;
		};
	};

	s_apb@ec000000 {
		compatible = "simple-bus";
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		reg = <0xec000000 0x1000000>;
		ranges;

		watchdog0: wdt@ec002000 {
			compatible = "ambarella,wdt";
			reg = <0xec002000 0x1000>;
			amb,rct-regmap = <0x9>;
			timeout-sec = <0xf>;
			amb,secure-ctrl-bit = <0x31>;
		};

		pinctrl: pinctrl@0xec003000 {
			compatible = "ambarella,pinctrl", "simple-bus";
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			reg = <0xec003000 0x1000 0xec004000 0x1000 0xec005000 0x1000 0xec006000 0x1000 0xec000000 0x1000 0xe0022014 0x3c 0xed080314 0x13c>;
			reg-names = "gpio0", "gpio1", "gpio2", "gpio3", "iomux", "pad", "ds";
			#gpio-range-cells = <0x3>;
			linux,phandle = <0x12>;
			phandle = <0x12>;

			gpio: gpio@0 {
				compatible = "ambarella,gpio";
				reg = <0x0>;
				interrupts = <0x0 0x2b 0x4 0x0 0x2c 0x4 0x0 0x2d 0x4 0x0 0x2e 0x4>;
				gpio-controller;
				#gpio-cells = <0x2>;
				gpio-ranges = <0x12 0x0 0x0 0x6c>;
				interrupt-controller;
				#interrupt-cells = <0x2>;
				linux,phandle = <0x10>;
				phandle = <0x10>;
			};

			uart0_pins: uart0@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x1011 0x1012>;
				u-boot,dm-pre-reloc;
				linux,phandle = <0x4>;
				phandle = <0x4>;
			};

			uart1_pins: uart1@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x1057 0x1058>;
				linux,phandle = <0x31>;
				phandle = <0x31>;
			};

			uart1_flow_pins: uart1_flow@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x1059 0x105a>;
				linux,phandle = <0x32>;
				phandle = <0x32>;
			};

			uart2_pins: uart2@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x105b 0x105c>;
				linux,phandle = <0x34>;
				phandle = <0x34>;
			};

			uart2_flow_pins: uart2_flow@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x105d 0x105e>;
				linux,phandle = <0x35>;
				phandle = <0x35>;
			};

			uart3_pins_a: uart3@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x1048 0x1049>;
			};

			uart3_pins_b: uart3@1 {
				reg = <0x1>;
				amb,pinmux-ids = <0x4061 0x4062>;
				linux,phandle = <0x37>;
				phandle = <0x37>;
			};

			uart3_flow_pins_a: uart3_flow@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x104a 0x104b>;
			};

			uart3_flow_pins_b: uart3_flow@1 {
				reg = <0x1>;
				amb,pinmux-ids = <0x4063 0x4064>;
				linux,phandle = <0x38>;
				phandle = <0x38>;
			};

			uart4_pins_a: uart4@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x104c 0x104d>;
				linux,phandle = <0x3a>;
				phandle = <0x3a>;
			};

			uart4_pins_b: uart4@1 {
				reg = <0x1>;
				amb,pinmux-ids = <0x4065 0x4066>;
			};

			uart4_flow_pins_a: uart4_flow@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x104e 0x104f>;
				linux,phandle = <0x3b>;
				phandle = <0x3b>;
			};

			uart4_flow_pins_b: uart4_flow@1 {
				reg = <0x1>;
				amb,pinmux-ids = <0x4067 0x4068>;
			};

			nand0_pins: nand0@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x202d 0x202e 0x202f 0x2034 0x2035 0x2036 0x2037 0x2038 0x2039 0x203a 0x203b 0x203c 0x203d 0x203e 0x203f>;
				linux,phandle = <0x13>;
				phandle = <0x13>;
			};

			snand0_pins: snand0@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x402d 0x4037 0x403b 0x403c 0x403d 0x403e>;
				linux,phandle = <0x14>;
				phandle = <0x14>;
			};

			spinor0_pins: spinor0@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x302d 0x302f 0x3034 0x3035 0x3036 0x3037 0x3038 0x3039 0x303a 0x303b 0x303c 0x303d 0x303e>;
				linux,phandle = <0x16>;
				phandle = <0x16>;
			};

			sdmmc0_cd_pin: sdmmc0_cd@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x2032>;
				linux,phandle = <0x1a>;
				phandle = <0x1a>;
			};

			sdmmc0_wp_pin: sdmmc0_wp@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x2033>;
				linux,phandle = <0x1b>;
				phandle = <0x1b>;
			};

			sdmmc0_reset_pin: sdmmc0_reset@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x2051>;
			};

			sdmmc0_pins_1bit: sdmmc0@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x2030 0x2031 0x2040>;
			};

			sdmmc0_pins_4bit: sdmmc0@1 {
				reg = <0x1>;
				amb,pinmux-ids = <0x2030 0x2031 0x2040 0x2041 0x2042 0x2043>;
			};

			sdmmc0_pins_8bit: sdmmc0@2 {
				reg = <0x2>;
				amb,pinmux-ids = <0x2030 0x2031 0x2040 0x2041 0x2042 0x2043 0x2044 0x2045 0x2046 0x2047>;
				linux,phandle = <0x19>;
				phandle = <0x19>;
			};

			sdmmc1_cd_pin: sdmmc1_cd@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x204e>;
				linux,phandle = <0x1e>;
				phandle = <0x1e>;
			};

			sdmmc1_wp_pin: sdmmc1_wp@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x204f>;
				linux,phandle = <0x1f>;
				phandle = <0x1f>;
			};

			sdmmc1_reset_pin: sdmmc1_reset@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x2050>;
			};

			sdmmc1_pins_1bit: sdmmc1@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x2048 0x2049 0x204a>;
			};

			sdmmc1_pins_4bit: sdmmc1@1 {
				reg = <0x1>;
				amb,pinmux-ids = <0x2048 0x2049 0x204a 0x204b 0x204c 0x204d>;
				linux,phandle = <0x1d>;
				phandle = <0x1d>;
			};

			sdmmc2_cd_pin: sdmmc2_cd@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x1067>;
				linux,phandle = <0x22>;
				phandle = <0x22>;
			};

			sdmmc2_wp_pin: sdmmc2_wp@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x1068>;
			};

			sdmmc2_pins_1bit: sdmmc2@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x1065 0x1066 0x1061>;
			};

			sdmmc2_pins_4bit: sdmmc2@1 {
				reg = <0x1>;
				amb,pinmux-ids = <0x1065 0x1066 0x1061 0x1062 0x1063 0x1064>;
				linux,phandle = <0x21>;
				phandle = <0x21>;
			};

			rgmii_pins: eth0@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x401c 0x401d 0x401e 0x401f 0x4020 0x4021 0x4022 0x4023 0x4024 0x4025 0x4029 0x402a 0x402b 0x5026 0x5027>;
				linux,phandle = <0x28>;
				phandle = <0x28>;
			};

			rmii_pins: eth0@1 {
				reg = <0x1>;
				amb,pinmux-ids = <0x301c 0x301d 0x301e 0x3021 0x3022 0x3025 0x3029 0x302b 0x5026 0x5027>;
			};

			enet_ptp_pps_o_pins_a: enet_ptp_pps_o@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x4028>;
			};

			enet_ptp_pps_o_pins_b: enet_ptp_pps_o@1 {
				reg = <0x1>;
				amb,pinmux-ids = <0x3028>;
			};

			enet_2nd_ref_clk_pins_a: enet_2nd_ref_clk@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x302c>;
				linux,phandle = <0x29>;
				phandle = <0x29>;
			};

			enet_2nd_ref_clk_pins_b: enet_2nd_ref_clk@1 {
				reg = <0x1>;
				amb,pinmux-ids = <0x302a>;
			};

			i2c0_pins_a: i2c0@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x3001 0x3002>;
				linux,phandle = <0xa>;
				phandle = <0xa>;
			};

			i2c0_pins_b: i2c0@1 {
				reg = <0x1>;
				amb,pinmux-ids = <0x300f 0x3010>;
			};

			i2c0_pins_c: i2c0@2 {
				reg = <0x2>;
				amb,pinmux-ids = <0x304f 0x3050>;
			};

			i2c0_pins_d: i2c0@3 {
				reg = <0x3>;
				amb,pinmux-ids = <0x205f 0x2060>;
			};

			i2c1_pins_a: i2c1@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x2006 0x2007>;
			};

			i2c1_pins_b: i2c1@1 {
				reg = <0x1>;
				amb,pinmux-ids = <0x3065 0x3066>;
				linux,phandle = <0xd>;
				phandle = <0xd>;
			};

			i2c2_pins_a: i2c2@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x2004 0x2008>;
			};

			i2c2_pins_b: i2c2@1 {
				reg = <0x1>;
				amb,pinmux-ids = <0x3067 0x3068>;
				linux,phandle = <0xe>;
				phandle = <0xe>;
			};

			i2c3_pins: i2c3@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x200b 0x200c>;
				linux,phandle = <0xf>;
				phandle = <0xf>;
			};

			ir_pins: ir0@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x1003>;
				linux,phandle = <0x6>;
				phandle = <0x6>;
			};

			wdt_pins_a: wdt0@0 {
				reg = <0x0>;
				amb,pinmux-ids = <0x2003>;
			};

			wdt_pins_b: wdt0@1 {
				reg = <0x1>;
				amb,pinmux-ids = <0x3008>;
